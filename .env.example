# 复制为 .env 后在本地填写密钥；请勿在示例文件填写真实密钥。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 百炼低价向量模型；启用 embedding profile，不与 local-embedding 同时启用。
DASHSCOPE_API_KEY=
TOURMATE_EMBEDDING_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/embeddings
TOURMATE_EMBEDDING_MODEL=qwen3.7-text-embedding-flash

# 本地向量模型不需要 Key；启用 local-embedding profile。
TOURMATE_LOCAL_EMBEDDING_URL=http://localhost:11434/api/embed
TOURMATE_LOCAL_EMBEDDING_MODEL=qwen3-embedding:0.6b

# MCP 工具服务地址；启用 agent profile 时先启动 tools-server。
TOURMATE_MCP_BASE_URL=http://127.0.0.1:18090
