# 复制为 .env 后在本地填写密钥；请勿在示例文件填写真实密钥。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 推荐的真实向量模式：启用 embedding profile，默认 text-embedding-v4。
# DeepSeek Key 只用于对话；该 Key 用于 DashScope 向量服务。
DASHSCOPE_API_KEY=
TOURMATE_EMBEDDING_MODEL=text-embedding-v4

# 可选本地向量模型，不需要 Key；启用 local-embedding profile。
# embedding 与 local-embedding 二选一。
TOURMATE_LOCAL_EMBEDDING_URL=http://localhost:11434/api/embed
TOURMATE_LOCAL_EMBEDDING_MODEL=qwen3-embedding:0.6b
